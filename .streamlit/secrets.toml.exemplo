# EXEMPLO — renomeie para secrets.toml (local) ou cole no Streamlit Cloud
# em Settings → Secrets. NUNCA suba secrets.toml com senhas para o Git.

[auth]
# Gere cada hash rodando, na pasta do projeto:
#   python -m functions.auth "a-senha-do-colega" nome_do_usuario
# e cole a linha impressa aqui. Exemplo:
# lucas = "pbkdf2_sha256$260000$<salt>$<hash>"
# cadu  = "pbkdf2_sha256$260000$<salt>$<hash>"

[postgres]
# Só é necessário em produção (Streamlit Cloud). Se você não preencher isto,
# o app usa o SQLite local automaticamente (data/gpflow.db) — nada muda no
# seu ambiente local.
#
# Cole aqui a "Connection string" do Neon (ou Supabase), no formato:
#   url = "postgresql://usuario:senha@host/banco?sslmode=require"
# url = "postgresql://usuario:senha@ep-exemplo.neon.tech/gpflow?sslmode=require"

